# Optional. Without a key, Loan Assistant runs in demo mode (predefined contextual answers).
# Server-side only — never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

# Optional. Set to "mock" to force demo mode even when a key is present (useful for offline demos).
# LOANWISE_AI_MODE=mock
